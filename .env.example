# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不要提交真实密钥

# ===== 数据库 =====
RAG_DB_ENGINE=mysql
RAG_DB_HOST=localhost
RAG_DB_PORT=3306
RAG_DB_USER=root
RAG_DB_PASSWORD=change-me
RAG_DB_NAME=rag

# ===== 认证 =====
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
RAG_JWT_SECRET=change-me-to-a-random-48-bytes-secret

# ===== 异步任务队列 =====
RAG_REDIS_URL=redis://localhost:6379/0
